
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 25px;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #10152f, #253b80);
  color: #ffffff;
}

.app {
  width: 100%;
  max-width: 600px;
  padding: 35px;
  background: rgba(255, 255, 255, 0.09);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

.icon {
  font-size: 55px;
  text-align: center;
  margin-bottom: 15px;
}

h1 {
  text-align: center;
  font-size: 30px;
  margin-bottom: 12px;
}

.subtitle {
  text-align: center;
  color: #c8d2f2;
  margin-bottom: 25px;
  line-height: 1.6;
}

.status {
  text-align: center;
  padding: 12px;
  margin-bottom: 22px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  color: #91ffc5;
}

label {
  display: block;
  margin: 18px 0 9px;
  font-weight: bold;
}

select,
textarea {
  width: 100%;
  padding: 13px;
  border-radius: 10px;
  border: 1px solid #6575aa;
  font-size: 15px;
  font-family: inherit;
}

select {
  background: #ffffff;
  color: #202a4b;
}

textarea {
  resize: vertical;
  background: #f8faff;
  color: #202a4b;
  line-height: 1.7;
}

textarea:focus,
select:focus {
  outline: 2px solid #7c9cff;
}

.buttons,
.bottom-buttons {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

button {
  flex: 1;
  padding: 13px 10px;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s;
}

button:hover:not(:disabled) {
  transform: translateY(-2px);
  filter: brightness(1.1);
}

button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.start {
  background: #63e6a5;
  color: #102b24;
}

.stop {
  background: #ff7777;
  color: #ffffff;
}

.secondary {
  background: #dce5ff;
  color: #24376f;
}

.footer {
  text-align: center;
  color: #c8d2f2;
  font-size: 12px;
  margin-top: 25px;
}

@media (max-width: 480px) {
  .app {
    padding: 22px;
  }

  h1 {
    font-size: 24px;
  }

  .buttons,
  .bottom-buttons {
    flex-direction: column;
  }
}
